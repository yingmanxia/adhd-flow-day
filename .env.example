# 仅占位值，不含任何真实密钥；复制为 .env 后按需修改
APP_NAME=ADHD Flow Day
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# 逗号分隔的显式跨域来源；留空表示禁用 CORS（同源部署）
CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:5174

# 本地优先：对应 docker-compose.yml 的 PostgreSQL 16
# 云端迁移时只改这一处，表结构由 prisma migrate deploy 复用
DATABASE_URL=postgresql://adhd:adhd_local_only@127.0.0.1:5432/adhd_flow_day?schema=public

# Prisma 迁移专用直连串（Neon 集成注入名）；本地与 DATABASE_URL 相同，云端由集成自动注入
DATABASE_URL_UNPOOLED=

# Redis 本期仅作会话黑名单/埋点缓冲预留，业务代码暂不连接
REDIS_URL=redis://127.0.0.1:6379
